                style="display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 5px; font-size: 12px; font-weight: 600; text-decoration: none; background: rgb(26, 58, 26); color: rgb(58, 148, 104); border: 1px solid rgb(42, 136, 42);"
