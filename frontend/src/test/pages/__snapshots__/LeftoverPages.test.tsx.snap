              style="font-size: 11px; color: rgb(150, 148, 172); font-weight: 500; text-transform: uppercase; letter-spacing: 0.03em;"
            >
              epub mobi
            </span>
          </div>
        </div>
        <div
          style="display: flex; justify-content: space-between; align-items: baseline;"
        >
          <span
            style="font-size: 11px; font-weight: 600; color: rgb(98, 96, 122); text-transform: uppercase;"
          >
            Library
          </span>
          <span
            style="font-size: 13px; color: rgb(214, 212, 224); text-align: right;"
          >
            <span
              style="font-size: 12px; padding: 1px 8px; border-radius: 4px; background: rgba(88, 184, 204, 0.14); color: rgb(72, 152, 176); border: 1px solid rgba(88, 184, 204, 0.2);"
            >
              📖 Calibre Library
            </span>
          </span>
        </div>
      </div>
      <div
        class="sb-actions"
        style="display: flex; gap: 8px; margin-top: auto; padding-top: 12px; border-top: 1px solid rgb(46, 48, 72); flex-wrap: wrap;"
      >
        <button
          style="background: rgba(224, 96, 96, 0.133); color: rgb(192, 72, 72); border: 1px solid rgba(224, 96, 96, 0.267); border-radius: 8px; font-weight: 600; cursor: pointer; padding: 4px 10px; font-size: 12px;"
          title="Discard this match and mark the book as Not Found on MAM"
        >
           Remove MAM
        </button>
        <button
          style="background: rgb(34, 36, 56); color: rgb(150, 148, 172); border: 1px solid rgb(46, 48, 72); border-radius: 8px; font-weight: 600; cursor: pointer; padding: 4px 10px; font-size: 12px;"
          title="Mark this book as Not Applicable so MAM scans skip it (e.g. free-to-read, never on MAM)"
        >
           Skip MAM
        </button>
      </div>
      <div
        class="sb-actions"
        style="display: flex; gap: 8px; margin-top: auto; padding-top: 12px; border-top: 1px solid rgb(46, 48, 72); flex-wrap: wrap;"
      >
        <button
          style="background: rgb(30, 32, 52); color: rgb(214, 212, 224); border: 1px solid rgb(58, 60, 86); border-radius: 8px; font-weight: 600; cursor: pointer; padding: 4px 10px; font-size: 12px;"
        >
          Dismiss
        </button>
        <button
          style="background: rgb(30, 32, 52); color: rgb(214, 212, 224); border: 1px solid rgb(58, 60, 86); border-radius: 8px; font-weight: 600; cursor: pointer; padding: 4px 10px; font-size: 12px;"
        >
          <svg
            fill="none"
            height="16"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2.5"
            viewBox="0 0 24 24"
            width="16"
          >
            <path
              d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94"
            />
            <path
              d="M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19"
            />
            <line
              x1="1"
              x2="23"
              y1="1"
              y2="23"
            />
          </svg>
           Hide
        </button>
        <button
          style="background: rgb(107, 32, 32); color: rgb(255, 144, 144); border: 1px rgb(139, 48, 48); border-radius: 8px; font-weight: 600; cursor: pointer; padding: 4px 10px; font-size: 12px;"
        >
          Delete
        </button>
      </div>
    </div>
  </div>
</DocumentFragment>
`;

