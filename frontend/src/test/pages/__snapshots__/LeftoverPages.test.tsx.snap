                style="background: rgb(30, 32, 52); color: rgb(214, 212, 224); border: 1px solid rgb(58, 60, 86); border-radius: 8px; font-weight: 600; cursor: pointer; padding: 4px 10px; font-size: 12px;"
                title="Re-scan this book against MAM"
              >
                ↻ Re-scan
              </button>
              <button
                style="background: rgba(228, 184, 104, 0.133); color: rgb(228, 184, 104); border: 1px solid rgba(228, 184, 104, 0.267); border-radius: 8px; font-weight: 600; cursor: pointer; padding: 4px 10px; font-size: 12px;"
              >
                ⬇ Send to pipeline
              </button>
            </div>
          </div>
          <div
            style="display: flex; justify-content: flex-end; gap: 14px; margin-top: 4px; font-size: 11px; color: rgb(98, 96, 122); flex-wrap: wrap;"
