      >
        ⊘ N/A
      </button>
    </div>
    <div
      style="display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 360px), 1fr)); gap: 8px;"
    >
      <div
        style="display: flex; gap: 12px; padding: 8px; background: rgb(34, 36, 56); border: 1px solid rgb(58, 60, 86); border-radius: 12px; cursor: pointer; opacity: 1;"
      >
        <div
          style="width: 64px; height: 96px; flex-shrink: 0; background: rgb(30, 32, 52); border-radius: 8px; overflow: hidden; display: flex; align-items: center; justify-content: center;"
        >
          <span
            style="font-size: 24px; color: rgb(98, 96, 122);"
          >
            ?
          </span>
        </div>
        <div
          style="flex: 1 1 0%; min-width: 0px; display: flex; flex-direction: column; gap: 2px;"
        >
          <div
            style="display: flex; align-items: baseline; gap: 4px; font-size: 15px; font-weight: 600; color: rgb(236, 234, 244); line-height: 1.3;"
          >
            <span
              style="flex: 1 1 0%; min-width: 0px; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;"
            >
              Ninefold Tide
            </span>
          </div>
          <div
            style="font-size: 13px; color: rgb(150, 148, 172); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"
          >
            Ada Quill
          </div>
          <div
            style="display: flex; align-items: center; gap: 4px; margin-top: 4px; flex-wrap: wrap;"
          >
            <span
              style="display: inline-flex; align-items: center; gap: 4px; padding: 4px 8px; background: rgba(76, 184, 136, 0.14); color: rgb(76, 184, 136); border: 1px solid rgb(58, 148, 104); border-radius: 9999px; font-size: 12px; font-weight: 600; line-height: 1.2; white-space: nowrap;"
            >
              Owned
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</DocumentFragment>
`;

