                style="padding: 6px 8px; background: rgb(34, 36, 56); border: 1px solid rgb(58, 60, 86); border-radius: 6px; color: rgb(214, 212, 224); font-size: 13px; width: 100%; flex: 1 1 0%;"
                value=""
              />
              <button
                disabled=""
                style="background: rgb(228, 184, 104); border: 1px solid rgb(228, 184, 104); color: rgb(26, 28, 48); border-radius: 6px; padding: 4px 8px; cursor: pointer; font-size: 12px; font-weight: 700; opacity: 0.5;"
