            style="font-size: 11px; font-weight: 600; color: rgb(98, 96, 122); text-transform: uppercase;"
          >
            MAM URL
          </span>
          <input
            placeholder="https://www.myanonamouse.net/t/123456"
            style="padding: 6px 8px; background: rgb(34, 36, 56); border: 1px solid rgb(58, 60, 86); border-radius: 6px; color: rgb(214, 212, 224); font-size: 13px; width: 100%;"
            value=""
          />
          <span
            style="font-size: 10px; color: rgb(98, 96, 122); margin-top: 2px; display: block;"
          >
            Paste a MAM torrent URL to set status to Found. Clear to reset.
          </span>
        </div>
        <div>
          <span
            style="font-size: 11px; font-weight: 600; color: rgb(98, 96, 122); text-transform: uppercase;"
          >
            Description
          </span>
          <textarea
            rows="4"
            style="padding: 6px 8px; background: rgb(34, 36, 56); border: 1px solid rgb(58, 60, 86); border-radius: 6px; color: rgb(214, 212, 224); font-size: 13px; width: 100%; resize: vertical;"
          >
            A tide that comes in nine times a day.
          </textarea>
        </div>
        <div
          style="display: flex; gap: 6px;"
        >
          <button
            style="background: rgb(228, 184, 104); color: rgb(26, 28, 48); border: 1px solid rgb(228, 184, 104); border-radius: 8px; font-weight: 600; cursor: pointer; padding: 4px 10px; font-size: 12px;"
          >
            Save
          </button>
          <button
            style="background: transparent; color: rgb(214, 212, 224); border: 1px solid rgb(58, 60, 86); border-radius: 8px; font-weight: 600; cursor: pointer; padding: 4px 10px; font-size: 12px;"
          >
            Cancel
          </button>
        </div>
      </div>
    </div>
  </div>
</DocumentFragment>
