            </option>
            <option
              value="audiobook"
            >
              Audiobook only
            </option>
          </select>
        </div>
      </div>
      <div
        style="display: grid; grid-template-columns: minmax(0, 1fr) minmax(180px, 320px); align-items: center; padding: 14px 0px; border-bottom: 1px solid rgb(46, 48, 72); gap: 6px 16px;"
      >
        <div
          style="min-width: 0px;"
        >
          <div
            style="font-size: 15px; font-weight: 600; color: rgb(236, 234, 244);"
          >
            ABS Sync Interval
          </div>
          <div
            style="font-size: 13px; color: rgb(136, 134, 160); margin-top: 3px; line-height: 1.5;"
          >
            How often the scheduled library-sync loop checks Audiobookshelf for new audiobooks. 0 inherits the global Library Sync Interval (above in the Libraries section).
          </div>
        </div>
        <div
          style="display: flex; align-items: center; justify-content: flex-end; min-height: 32px;"
        >
          <div
            style="display: flex; align-items: center; gap: 6px;"
          >
            <input
              min="0"
              style="padding: 7px 12px; background: rgb(34, 36, 56); border: 1px solid rgb(58, 60, 86); border-radius: 6px; color: rgb(214, 212, 224); font-size: 13px; outline: none; width: 90px; text-align: center;"
              type="number"
              value="0"
            />
            <span
              style="font-size: 13px; color: rgb(136, 134, 160);"
            >
              min
            </span>
          </div>
        </div>
      </div>
      <div
        style="display: grid; grid-template-columns: minmax(0, 1fr) minmax(180px, 320px); align-items: center; padding: 14px 0px; border-bottom: 1px solid rgb(46, 48, 72); gap: 6px 16px;"
      >
        <div
          style="min-width: 0px;"
        >
          <div
            style="font-size: 15px; font-weight: 600; color: rgb(236, 234, 244);"
          >
            Audible Region
          </div>
          <div
            style="font-size: 13px; color: rgb(136, 134, 160); margin-top: 3px; line-height: 1.5;"
          >
            Controls which Audible TLD catalog searches hit. Audible also hydrates every hit through Audnexus internally using the same region code.
          </div>
        </div>
        <div
          style="display: flex; align-items: center; justify-content: flex-end; min-height: 32px;"
        >
          <select
            style="padding: 7px 12px; background: rgb(34, 36, 56); border: 1px solid rgb(58, 60, 86); border-radius: 6px; color: rgb(214, 212, 224); font-size: 13px; outline: none; width: 180px; cursor: pointer; appearance: auto;"
          >
            <option
              value="us"
            >
              us — .com (default)
            </option>
            <option
              value="uk"
            >
              uk — .co.uk
            </option>
            <option
              value="ca"
            >
              ca — .ca
            </option>
            <option
              value="au"
            >
              au — .com.au
            </option>
            <option
              value="de"
            >
              de — .de
            </option>
            <option
              value="fr"
            >
              fr — .fr
            </option>
            <option
              value="it"
            >
              it — .it
            </option>
            <option
              value="es"
            >
              es — .es
            </option>
            <option
              value="jp"
            >
              jp — .co.jp
            </option>
            <option
              value="in"
            >
              in — .in
            </option>
          </select>
        </div>
      </div>
      <div
        style="display: grid; grid-template-columns: minmax(0, 1fr) minmax(180px, 320px); align-items: center; padding: 14px 0px; border-bottom: 1px solid rgb(46, 48, 72); gap: 6px 16px;"
      >
        <div
          style="min-width: 0px;"
        >
          <div
            style="font-size: 15px; font-weight: 600; color: rgb(236, 234, 244);"
          >
            Rebuild Cross-Library Links
          </div>
          <div
            style="font-size: 13px; color: rgb(136, 134, 160); margin-top: 3px; line-height: 1.5;"
          >
            Re-run the matcher across every discovered library. Safe at any time — manual links are preserved.
          </div>
        </div>
        <div
          style="display: flex; align-items: center; justify-content: flex-end; min-height: 32px;"
        >
          <div
            style="display: flex; align-items: center; gap: 8px;"
          >
            <button
              style="background: transparent; color: rgb(214, 212, 224); border: 1px solid rgb(58, 60, 86); border-radius: 8px; font-weight: 600; cursor: pointer; padding: 8px 14px; font-size: 14px;"
            >
              Rebuild
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</DocumentFragment>
`;

