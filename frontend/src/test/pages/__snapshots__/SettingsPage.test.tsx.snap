          style="min-width: 0px;"
        >
          <div
            style="font-size: 15px; font-weight: 600; color: rgb(236, 234, 244);"
          >
            Metadata Enrichment
          </div>
          <div
            style="font-size: 13px; color: rgb(136, 134, 160); margin-top: 3px; line-height: 1.5;"
          >
            Scrapes 7 sources for covers, descriptions, series info, ISBN, and page counts.
          </div>
        </div>
        <div
          style="display: flex; align-items: center; justify-content: flex-end; min-height: 32px;"
        >
          <div
            style="display: flex; align-items: center; gap: 8px;"
          >
            <span
              style="font-size: 12px; color: rgb(136, 134, 160); font-weight: 600;"
            >
              OFF
            </span>
            <div
              style="width: 44px; height: 24px; border-radius: 12px; background: rgb(42, 44, 66); cursor: pointer; padding: 3px; transition: background 0.2s; opacity: 1;"
            >
              <div
                style="width: 18px; height: 18px; border-radius: 50%; background: rgb(255, 255, 255); transform: translateX(0); transition: transform 0.2s;"
              />
            </div>
          </div>
        </div>
      </div>
      <div
        style="display: grid; grid-template-columns: minmax(0, 1fr) minmax(180px, 320px); align-items: center; padding: 14px 0px; border-bottom: 1px solid rgb(46, 48, 72); gap: 6px 16px;"
      >
        <div
          style="min-width: 0px;"
        >
          <div
            style="font-size: 15px; font-weight: 600; color: rgb(236, 234, 244);"
          >
            Review Timeout
          </div>
          <div
            style="font-size: 13px; color: rgb(136, 134, 160); margin-top: 3px; line-height: 1.5;"
          >
            Books undecided for this long are auto-added to Calibre.
          </div>
        </div>
        <div
          style="display: flex; align-items: center; justify-content: flex-end; min-height: 32px;"
        >
          <div
            style="display: flex; align-items: center; gap: 6px;"
          >
            <input
              min="1"
              style="padding: 7px 12px; background: rgb(34, 36, 56); border: 1px solid rgb(58, 60, 86); border-radius: 6px; color: rgb(214, 212, 224); font-size: 13px; outline: none; width: 90px; text-align: center;"
              type="number"
              value="14"
            />
            <span
              style="font-size: 12px; color: rgb(136, 134, 160);"
            >
              days
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</DocumentFragment>
`;

