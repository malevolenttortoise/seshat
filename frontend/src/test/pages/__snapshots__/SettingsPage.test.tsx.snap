        style="display: inline-flex; align-items: center; justify-content: center; gap: 8px; background: rgb(228, 184, 104); color: rgb(26, 28, 48); border: 1px solid rgb(228, 184, 104); border-radius: 10px; font-size: 16px; font-weight: 600; min-height: 48px; padding: 0px 16px; cursor: pointer;"
      >
        <span>
          Save settings
        </span>
      </button>
    </div>
  </div>
</DocumentFragment>
`;

exports[`Settings sections (phone) > every section open > requests 1`] = `
[
  "GET /v1/credentials",
  "GET /v1/settings",
]
`;
