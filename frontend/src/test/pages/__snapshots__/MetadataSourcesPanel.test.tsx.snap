              style="width: 18px; height: 18px; cursor: pointer;"
              type="checkbox"
            />
            <span
              style="font-size: 13px; font-weight: 600; color: rgb(236, 234, 244);"
            >
              Enrich
            </span>
          </label>
          <label
            style="display: flex; align-items: center; gap: 8px; padding: 8px 12px; background: rgb(30, 32, 52); border: 1px solid rgb(46, 48, 72); border-radius: 6px; cursor: pointer; opacity: 1;"
            title="Include in per-author ebook scans."
          >
            <input
              checked=""
              style="width: 18px; height: 18px; cursor: pointer;"
              type="checkbox"
            />
            <span
              style="font-size: 13px; font-weight: 600; color: rgb(236, 234, 244);"
            >
              Scan
            </span>
          </label>
          <label
            style="display: flex; align-items: center; gap: 8px; padding: 8px 12px; background: rgb(30, 32, 52); border: 1px solid rgb(46, 48, 72); border-radius: 6px; cursor: pointer; opacity: 1;"
            title="Keep DETAIL-fetching until every book has a URL from this source."
          >
            <input
              style="width: 18px; height: 18px; cursor: pointer;"
              type="checkbox"
            />
            <span
              style="font-size: 13px; font-weight: 600; color: rgb(236, 234, 244);"
            >
              Mandatory
            </span>
          </label>
        </div>
        <div
          style="display: flex; align-items: center; gap: 12px;"
        >
          <span
            style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: rgb(136, 134, 160); min-width: 80px;"
          >
            Rate (s)
          </span>
          <input
            max="100"
            min="0.1"
            step="0.5"
            style="width: 90px; padding: 5px 8px; text-align: center; border-radius: 6px; border: 1px solid rgb(58, 60, 86); background: rgb(34, 36, 56); color: rgb(214, 212, 224); font-size: 13px; outline: none; opacity: 1;"
            type="number"
            value="1"
          />
          <span
            style="font-size: 11px; color: rgb(136, 134, 160); font-style: italic;"
          >
            Minimum gap between any two requests to this source, from any part of Seshat.
          </span>
        </div>
        <div
          style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px;"
        >
          <div
            style="display: flex; align-items: center; gap: 10px; padding: 10px 12px; background: rgb(30, 32, 52); border: 1px solid rgb(46, 48, 72); border-radius: 6px; opacity: 1;"
          >
            <span
              style="font-size: 11px; font-weight: 700; text-transform: capitalize; letter-spacing: 0.5px; color: rgb(136, 134, 160);"
            >
