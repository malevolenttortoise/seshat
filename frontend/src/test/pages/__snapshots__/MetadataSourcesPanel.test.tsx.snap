                >
                  64
                </span>
              </div>
            </div>
            <label
              style="display: flex; align-items: center; gap: 8px; font-size: 12px; cursor: pointer;"
            >
              <input
                type="checkbox"
              />
              <span
                style="color: rgb(214, 212, 224); font-weight: 600;"
              >
                Phase 2: fetch every listed book's page
              </span>
              <span
                style="color: rgb(136, 134, 160); font-size: 11px;"
