                style="color: rgb(136, 134, 160);"
              >
                s
              </span>
            </label>
            <span
              style="color: rgb(136, 134, 160); font-size: 11px; font-style: italic;"
            >
              Book pages wait this long after the last one, on top of the Rate: Goodreads blocks a run of book pages from one address.
            </span>
          </div>
          <label
            style="display: flex; align-items: flex-start; gap: 8px; cursor: pointer;"
          >
            <input
              style="margin-top: 2px;"
              type="checkbox"
            />
            <span
              style="display: flex; flex-direction: column; gap: 2px;"
            >
              <span
                style="color: rgb(214, 212, 224); font-weight: 600;"
              >
                Include non-fiction from Goodreads
              </span>
              <span
                style="color: rgb(136, 134, 160); font-size: 11px;"
              >
                Off: books Goodreads files under Nonfiction, Self Help, Sports, Puzzles, Cookbooks, Reference or Picture Books aren't added to discovery. Turn on if you collect non-fiction.
              </span>
            </span>
          </label>
        </div>
        <div
          style="display: flex; flex-direction: column; gap: 10px; padding: 10px 4px 14px 60px; border-bottom: 1px solid rgb(46, 48, 72); font-size: 12px;"
        >
          <div
            style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;"
          >
            <span
              style="color: rgb(136, 134, 160); font-weight: 600;"
            >
              Session state
            </span>
            <span
              style="font-size: 11px; font-weight: 700; text-transform: uppercase; padding: 3px 9px; border-radius: 99px; letter-spacing: 0.5px; background: rgba(76, 184, 136, 0.133); color: rgb(76, 184, 136);"
            >
              Active
            </span>
            <span
              style="color: rgb(136, 134, 160); font-size: 11px;"
            >
              last HTTP 200
            </span>
          </div>
          <div
            style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px 12px; background: rgb(30, 32, 52); border: 1px solid rgb(46, 48, 72); border-radius: 6px; padding: 6px 10px;"
          >
            <div
              style="display: flex; flex-direction: column; gap: 1px;"
            >
              <span
                style="color: rgb(136, 134, 160); font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.4px;"
              >
                Book pages
              </span>
              <span
                style="color: rgb(76, 184, 136); font-size: 12px; font-weight: 600;"
              >
                OK
              </span>
