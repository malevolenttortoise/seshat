              style="flex: 1 1 0%;"
            />
            <button
              disabled=""
              style="background: none; border: 1px solid rgb(46, 48, 72); border-radius: 4px; padding: 3px 7px; cursor: default; color: rgb(46, 48, 72); opacity: 0.4; font-size: 11px;"
              title="Already at top"
            >
              ▲
            </button>
            <button
              style="background: none; border: 1px solid rgb(46, 48, 72); border-radius: 4px; padding: 3px 7px; cursor: pointer; color: rgb(236, 234, 244); opacity: 1; font-size: 11px;"
              title="Move down"
            >
              ▼
            </button>
          </div>
          <div
            style="display: flex; align-items: center; gap: 10px; padding: 10px 12px; background: rgb(30, 32, 52); border: 1px solid rgb(46, 48, 72); border-radius: 6px; opacity: 1;"
