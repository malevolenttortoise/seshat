          style="padding: 10px 4px 12px 0px; font-size: 12px; display: flex; flex-direction: column; gap: 8px; border-top: 1px solid rgb(46, 48, 72); margin-top: 4px;"
        >
          <div
            style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;"
          >
            <span
              style="color: rgb(136, 134, 160); font-weight: 600;"
            >
              Amazon cache worker
            </span>
            <span
              style="font-size: 11px; font-weight: 700; text-transform: uppercase; padding: 3px 9px; border-radius: 99px; letter-spacing: 0.5px; background: rgba(76, 184, 136, 0.133); color: rgb(76, 184, 136);"
            >
              Active
            </span>
            <span
              style="flex: 1 1 0%;"
            />
            <div
              style="display: flex; gap: 0px; align-items: stretch;"
            >
              <button
                disabled=""
                style="padding: 4px 10px; font-size: 11px; font-weight: 600; background: rgba(228, 184, 104, 0.133); color: rgb(228, 184, 104); border: 1px solid rgb(228, 184, 104); border-top-left-radius: 4px; border-bottom-left-radius: 4px; border-top-right-radius: 0px; border-bottom-right-radius: 0px; cursor: default; opacity: 1;"
                title="Worker fires every 30–90s round the clock."
              >
                Continuous
              </button>
              <button
                style="padding: 4px 10px; font-size: 11px; font-weight: 600; background: rgb(30, 32, 52); color: rgb(236, 234, 244); border-width: 1px 1px 1px 0px; border-style: solid; border-color: rgb(46, 48, 72); border-image: none; border-top-left-radius: 0px; border-bottom-left-radius: 0px; border-top-right-radius: 0px; border-bottom-right-radius: 0px; cursor: pointer; opacity: 1;"
                title="Worker only runs inside the active-hours window below."
              >
                Scheduled
              </button>
              <button
                style="padding: 4px 10px; font-size: 11px; font-weight: 600; background: rgb(30, 32, 52); color: rgb(236, 234, 244); border-width: 1px 1px 1px 0px; border-style: solid; border-color: rgb(46, 48, 72); border-image: none; border-top-left-radius: 0px; border-bottom-left-radius: 0px; border-top-right-radius: 4px; border-bottom-right-radius: 4px; cursor: pointer; opacity: 1;"
                title="Worker stays idle; cache reads still hit existing rows."
              >
                Disabled
              </button>
            </div>
            <span
              style="color: rgb(136, 134, 160); font-size: 11px;"
            >
              heartbeat 30s ago
            </span>
          </div>
          <div
            style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 4px 12px; background: rgb(30, 32, 52); border: 1px solid rgb(46, 48, 72); border-radius: 6px; padding: 6px 10px;"
          >
            <div
              style="display: flex; flex-direction: column; gap: 1px; min-width: 0px; padding: 2px 0px;"
              title="598 cooling off"
            >
              <span
                style="color: rgb(136, 134, 160); font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.4px;"
              >
                Queue
              </span>
              <span
                style="color: rgb(214, 212, 224); font-size: 13px; font-weight: 600; line-height: 1.2;"
              >
                12
              </span>
            </div>
            <div
              style="display: flex; flex-direction: column; gap: 1px; min-width: 0px; padding: 2px 0px;"
              title="ok / total (author-level)"
            >
              <span
                style="color: rgb(136, 134, 160); font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.4px;"
              >
                Authors cached
              </span>
              <span
                style="color: rgb(214, 212, 224); font-size: 13px; font-weight: 600; line-height: 1.2;"
              >
                595 / 640
              </span>
            </div>
            <div
              style="display: flex; flex-direction: column; gap: 1px; min-width: 0px; padding: 2px 0px;"
            >
              <span
                style="color: rgb(136, 134, 160); font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.4px;"
              >
                Books cached
              </span>
              <span
                style="color: rgb(214, 212, 224); font-size: 13px; font-weight: 600; line-height: 1.2;"
              >
                9,100
              </span>
            </div>
            <div
              style="display: flex; flex-direction: column; gap: 1px; min-width: 0px; padding: 2px 0px;"
            >
              <span
                style="color: rgb(136, 134, 160); font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.4px;"
              >
                Last scan
              </span>
              <span
                style="color: rgb(214, 212, 224); font-size: 13px; font-weight: 600; line-height: 1.2;"
              >
                5m ago
              </span>
            </div>
            <div
              style="display: flex; flex-direction: column; gap: 1px; min-width: 0px; padding: 2px 0px;"
              title="40 authors attempted since midnight; routine refreshes stop at 101 a day (new authors skip the cap)"
            >
              <span
                style="color: rgb(136, 134, 160); font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.4px;"
              >
                Scans today
              </span>
              <span
                style="color: rgb(214, 212, 224); font-size: 13px; font-weight: 600; line-height: 1.2;"
              >
                42
              </span>
            </div>
            <div
              style="display: flex; flex-direction: column; gap: 1px; min-width: 0px; padding: 2px 0px;"
            >
              <span
                style="color: rgb(136, 134, 160); font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.4px;"
              >
                Blocks today
              </span>
              <span
                style="color: rgb(214, 212, 224); font-size: 13px; font-weight: 600; line-height: 1.2;"
              >
                0
              </span>
            </div>
            <div
              style="display: flex; flex-direction: column; gap: 1px; min-width: 0px; padding: 2px 0px;"
            >
              <span
                style="color: rgb(136, 134, 160); font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.4px;"
              >
                In progress
              </span>
              <span
                style="color: rgb(214, 212, 224); font-size: 13px; font-weight: 600; line-height: 1.2;"
              >
                1
              </span>
            </div>
            <div
              style="display: flex; flex-direction: column; gap: 1px; min-width: 0px; padding: 2px 0px;"
            >
              <span
                style="color: rgb(136, 134, 160); font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.4px;"
              >
                Failed perm.
              </span>
              <span
                style="color: rgb(214, 212, 224); font-size: 13px; font-weight: 600; line-height: 1.2;"
              >
                0
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div
      style="position: sticky; bottom: 12px; display: flex; justify-content: flex-end; gap: 10px; background: rgba(26, 28, 48, 0.933); backdrop-filter: blur(8px); padding: 12px 0px; border-top: 1px solid rgb(46, 48, 72); margin-top: 8px;"
    >
      <button
        style="background: transparent; color: rgb(214, 212, 224); border: 1px solid rgb(58, 60, 86); border-radius: 8px; font-weight: 600; cursor: pointer; padding: 8px 14px; font-size: 14px;"
        title="Wipe all panel settings + reapply v2.11.x ship-defaults"
      >
        Reset to defaults
      </button>
      <span
        style="flex: 1 1 0%;"
      />
      <span
        style="font-size: 13px; color: rgb(136, 134, 160); align-self: center;"
      >
        No unsaved changes
      </span>
      <button
        disabled=""
        style="background: transparent; color: rgb(214, 212, 224); border: 1px solid rgb(58, 60, 86); border-radius: 8px; font-weight: 600; cursor: pointer; padding: 8px 14px; font-size: 14px;"
      >
        Discard
      </button>
      <button
        disabled=""
        style="background: rgb(228, 184, 104); color: rgb(26, 28, 48); border: 1px solid rgb(228, 184, 104); border-radius: 8px; font-weight: 600; cursor: pointer; padding: 8px 14px; font-size: 14px;"
      >
        Save
      </button>
    </div>
  </div>
</DocumentFragment>
`;

exports[`Metadata Sources panel (desktop) > Amazon's details with its cache card > requests 1`] = `
[
  "GET /v1/metadata-cache/amazon/status",
  "GET /v1/metadata-sources",
  "GET /v1/metadata-sources/traffic?days=8",
]
`;

exports[`Metadata Sources panel (desktop) > Goodreads' cache card in cooldown > markup 1`] = `
<DocumentFragment>
  <div
    style="display: flex; flex-direction: column; gap: 12px;"
  >
    <div
      style="font-size: 13px; color: rgb(136, 134, 160); line-height: 1.6; margin: 0px; padding: 10px 14px; background: rgb(30, 32, 52); border-radius: 8px; border: 1px solid rgb(46, 48, 72);"
    >
      <div
        style="margin-bottom: 4px;"
      >
        <strong
          style="color: rgb(214, 212, 224);"
        >
          Enrich
        </strong>
         — sources run after a book downloads, merging title / description / ISBN / cover / narrator / etc. into the review-queue metadata.
      </div>
      <div
        style="margin-bottom: 4px;"
      >
        <strong
          style="color: rgb(214, 212, 224);"
        >
          Scan
        </strong>
         — sources run during library-side author scanning to find books you don't have yet.
      </div>
      <div>
        <strong
          style="color: rgb(214, 212, 224);"
        >
          Rate (s)
        </strong>
         — the minimum gap between any two requests to this source, from anything in Seshat (scans, the cache workers, enrichment). Higher = gentler on the upstream, slower scans. Leave at default if unsure.
      </div>
      <div
        style="margin-top: 6px; color: rgb(136, 134, 160);"
      >
        Priority is top-to-bottom; drag rows to reorder. MAM is always first and free — its row is locked.
      </div>
    </div>
    <div
      style="background: rgba(228, 184, 104, 0.094); border: 1px solid rgba(228, 184, 104, 0.333); color: rgb(236, 234, 244); padding: 10px 14px; border-radius: 8px; font-size: 13px; display: flex; gap: 12px; align-items: center; flex-wrap: wrap;"
    >
      <span
        style="flex: 1 1 0%;"
      >
        <b>
          v2.13.0:
        </b>
         Goodreads's default rate limit is now 
        <b>
          5.0s
        </b>
